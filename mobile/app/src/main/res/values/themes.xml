<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.QueueEase" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/blue_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_50</item>
        <item name="colorOnPrimaryContainer">@color/blue_700</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/green_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/green_50</item>
        <item name="colorOnSecondaryContainer">@color/green_600</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/purple_500</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Error -->
        <item name="colorError">@color/red_500</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/red_50</item>

        <!-- Surface -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/gray_800</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/gray_600</item>
        <item name="colorOutline">@color/border_normal</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/gray_50</item>
        <item name="colorOnBackground">@color/gray_800</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/gray_50</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/QueueEase.ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/QueueEase.ShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/QueueEase.ShapeLarge</item>
        
        <!-- Typography -->
    </style>

    <style name="Theme.QueueEase" parent="Base.Theme.QueueEase" />

    <!-- Shapes -->
    <style name="QueueEase.ShapeSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>
    <style name="QueueEase.ShapeMedium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/radius_md</item>
    </style>
    <style name="QueueEase.ShapeLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>
</resources>