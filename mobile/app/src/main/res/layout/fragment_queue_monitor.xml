<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray_50"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <com.google.android.material.card.MaterialCardView
                style="@style/QueueEase.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeColor="@color/blue_100"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/blue_600">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        style="@style/QueueEase.Text.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENTLY SERVING"
                        android:textColor="@color/white"
                        android:alpha="0.8" />

                    <TextView
                        android:id="@+id/tvCurrentServingNumber"
                        style="@style/QueueEase.Text.HeroNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="72sp"
                        android:textColor="@color/white"
                        tools:text="#42" />

                    <TextView
                        android:id="@+id/tvCurrentServingName"
                        style="@style/QueueEase.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        tools:text="Jane Doe" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMarkMissed"
                            style="@style/QueueEase.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="4dp"
                            app:strokeColor="@color/red_200"
                            android:backgroundTint="#FFE4E6"
                            android:textColor="@color/red_600"
                            android:text="No Show" />

                        <Button
                            android:id="@+id/btnMarkServed"
                            style="@style/QueueEase.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="4dp"
                            android:backgroundTint="@color/white"
                            android:textColor="@color/green_600"
                            android:text="Served" />

                        <Button
                            android:id="@+id/btnCallNext"
                            style="@style/QueueEase.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="4dp"
                            android:backgroundTint="@color/white"
                            android:textColor="@color/blue_600"
                            android:text="Next" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/tvListHeader"
                style="@style/QueueEase.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="Waiting Queue" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvQueue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_queue_monitor" />
                
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_people"
                app:tint="@color/gray_300" />

            <TextView
                style="@style/QueueEase.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Queue is empty"
                android:textColor="@color/gray_500" />
        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
