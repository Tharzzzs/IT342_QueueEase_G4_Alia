<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/QueueEase.Text.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_dashboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llStatsRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <!-- Active Centers Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card_blue"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                style="@style/QueueEase.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/active_centers" />

            <TextView
                android:id="@+id/tvActiveCenters"
                style="@style/QueueEase.Text.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/blue_600"
                tools:text="12" />
        </LinearLayout>

        <!-- Total In Queue Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card_amber"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="8dp">

            <TextView
                style="@style/QueueEase.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/people_in_queue" />

            <TextView
                android:id="@+id/tvTotalInQueue"
                style="@style/QueueEase.Text.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/amber_500"
                tools:text="45" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llStatsRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@id/llStatsRow1">

        <!-- Served Today Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card_green"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                style="@style/QueueEase.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/served_today" />

            <TextView
                android:id="@+id/tvServedToday"
                style="@style/QueueEase.Text.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/green_600"
                tools:text="128" />
        </LinearLayout>

        <!-- Total Centers Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_card_purple"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="8dp">

            <TextView
                style="@style/QueueEase.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_centers" />

            <TextView
                android:id="@+id/tvTotalCenters"
                style="@style/QueueEase.Text.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/purple_500"
                tools:text="15" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
