<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_600"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/QueueEase.Text.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:text="@string/active_queue" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingBottom="48dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                style="@style/QueueEase.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_normal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="32dp"
                    android:paddingBottom="32dp"
                    android:paddingHorizontal="24dp">

                    <TextView
                        style="@style/QueueEase.Text.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/queue_number"
                        android:textColor="@color/gray_500" />

                    <TextView
                        android:id="@+id/tvQueueNumber"
                        style="@style/QueueEase.Text.HeroNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/blue_600"
                        android:textSize="64sp"
                        tools:text="42" />

                    <TextView
                        android:id="@+id/tvStatusSubtitle"
                        style="@style/QueueEase.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        tools:text="Position: 3 • Waiting" />
                        
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="24dp"
                        android:background="@color/border_subtle" />

                    <TextView
                        style="@style/QueueEase.Text.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/service_center"
                        android:layout_gravity="start" />

                    <TextView
                        android:id="@+id/tvCenterName"
                        style="@style/QueueEase.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_gravity="start"
                        android:textSize="20sp"
                        tools:text="Central Bank Main Branch" />

                    <View
                        android:id="@+id/currentlyServingDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="24dp"
                        android:background="@color/border_subtle"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvCurrentlyServingLabel"
                        style="@style/QueueEase.Text.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENTLY SERVING"
                        android:layout_gravity="start"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvCurrentlyServing"
                        style="@style/QueueEase.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/green_600"
                        android:layout_gravity="start"
                        android:textSize="24sp"
                        android:visibility="gone"
                        tools:text="#42" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="24dp"
                        android:background="@color/border_subtle" />

                    <TextView
                        style="@style/QueueEase.Text.SectionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="JOINED AT" />

                    <TextView
                        android:id="@+id/tvJoinedAt"
                        style="@style/QueueEase.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_gravity="start"
                        android:textStyle="bold"
                        android:textColor="@color/gray_900"
                        tools:text="14:30 PM" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnLeaveQueue"
                style="@style/QueueEase.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="@string/leave_queue" />

            <Button
                android:id="@+id/btnBack"
                style="@style/QueueEase.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/back_to_home" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
