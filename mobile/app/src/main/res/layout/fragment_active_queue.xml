<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/QueueEase.Text.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/active_queue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_hero_queue"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <TextView
            style="@style/QueueEase.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/queue_number"
            android:textColor="@color/white"
            android:alpha="0.9" />

        <TextView
            android:id="@+id/tvQueueNumber"
            style="@style/QueueEase.Text.HeroNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="#42" />

        <TextView
            android:id="@+id/tvStatusSubtitle"
            style="@style/QueueEase.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/white"
            android:alpha="0.9"
            tools:text="Position: 3 • Waiting" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/heroCard">

        <TextView
            style="@style/QueueEase.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/service_center" />

        <TextView
            android:id="@+id/tvCenterName"
            style="@style/QueueEase.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            tools:text="Central Bank Main Branch" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/gray_200" />

        <TextView
            style="@style/QueueEase.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/joined_at" />

        <TextView
            android:id="@+id/tvJoinedAt"
            style="@style/QueueEase.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="14:30 PM" />

    </LinearLayout>

    <Button
        android:id="@+id/btnLeaveQueue"
        style="@style/QueueEase.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/leave_queue"
        app:layout_constraintBottom_toTopOf="@id/btnBack" />

    <Button
        android:id="@+id/btnBack"
        style="@style/QueueEase.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_home"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
